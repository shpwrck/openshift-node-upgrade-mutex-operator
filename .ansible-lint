---
# ansible-lint settings for `make lint` and CI.
exclude_paths:
  - .github/
  - bin/
  - bundles/
  - catalog/
  - catalog-template.yaml
  - config/
  - molecule/
  - sample-manifests/
  - tests/

# Findings that already exist in roles/ are reported as warnings instead of
# failing the build. Drop an entry once the roles no longer trigger it.
warn_list:
  - var-naming[pattern]         # camelCase fact names used across the roles
  - var-naming[no-role-prefix]
  - var-naming[no-reserved]     # facts named `query`
  - meta-incorrect              # scaffolded galaxy_info placeholders
  - schema[meta]
  - yaml[indentation]
  - yaml[comments]
  - args[module]                # templated k8s_status condition status
  - fqcn[action-core]
  - no-jinja-when
