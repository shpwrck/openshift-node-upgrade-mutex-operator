# Release settings for maintainers who use direnv (https://direnv.net).
# Without direnv the Makefile reads MAJOR/MINOR/PATCH from this file, and
# `make increment` bumps PATCH here.
export MAJOR=0
export MINOR=3
export PATCH=0
export USE_IMAGE_DIGESTS=true
export VERSION=${MAJOR}.${MINOR}.${PATCH}
# Registry the release images are pushed to. Point it at the registry of the
# organization that publishes the operator.
export IMAGE_TAG_BASE=quay.io/jskrzypek/openshift-node-upgrade-mutex-operator
