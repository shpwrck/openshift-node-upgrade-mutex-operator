# Release settings for maintainers who use direnv (https://direnv.net).
# Without direnv the Makefile reads MAJOR/MINOR/PATCH from this file, and
# `make increment` bumps PATCH here.
export MAJOR=0
export MINOR=3
export PATCH=0
export USE_IMAGE_DIGESTS=true
export VERSION=${MAJOR}.${MINOR}.${PATCH}
# Registry the release images are pushed to, and the repository the images are
# labelled with (org.opencontainers.image.source). The release workflow
# (.github/workflows/release.yaml) sets both from the repository it runs in.
export IMAGE_TAG_BASE=ghcr.io/redhat-na-ssa/openshift-node-upgrade-mutex-operator
export IMAGE_SOURCE=https://github.com/redhat-na-ssa/openshift-node-upgrade-mutex-operator
