[connection]
id=bond0
uuid=08c1a16d-21bb-4a56-b706-ffe9bb4bda9f
type=bond
autoconnect-ports=1
interface-name=bond0

[bond]
miimon=100
mode=802.3ad

[ipv4]
address1=172.16.10.10/20
dhcp-timeout=2147483647
dns=172.16.0.1;
dns-options=
dns-priority=40
method=manual
route1=0.0.0.0/0,172.16.0.1,0
route1_options=table=254

[ipv6]
