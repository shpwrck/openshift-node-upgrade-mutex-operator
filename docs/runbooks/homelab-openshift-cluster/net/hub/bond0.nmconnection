[connection]
id=bond0
uuid=eed01ae7-6fbe-4432-b20b-9a1274b4356c
type=bond
autoconnect-ports=1
interface-name=bond0

[bond]
miimon=100
mode=802.3ad

[ipv4]
address1=172.16.10.9/20
dhcp-timeout=2147483647
dns=172.16.0.1;
dns-options=
dns-priority=40
method=manual
route1=0.0.0.0/0,172.16.0.1,0
route1_options=table=254

[ipv6]
addr-gen-mode=default
dhcp-timeout=2147483647
method=disabled

[proxy]
